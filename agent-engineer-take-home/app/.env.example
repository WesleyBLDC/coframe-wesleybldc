OPENAI_API_KEY=
# OpenRouter key goes in OPENAI_API_KEY; requests use its OpenAI compatible API.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Comma separated, tried in order (OpenRouter `models` fallback on errors and rate limits).
LLM_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3.5-super-vl:free
